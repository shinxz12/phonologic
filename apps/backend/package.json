{
  "name": "@phonologic/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --filter @phonologic/db generate",
    "db:migrate": "bun --filter @phonologic/db migrate",
    "db:push": "bun --filter @phonologic/db push",
    "db:seed": "bun --filter @phonologic/db seed",
    "db:studio": "bun --filter @phonologic/db studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@phonologic/db": "workspace:*",
    "@phonologic/shared-types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "@phonologic/tsconfig": "workspace:*"
  }
}
