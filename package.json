{
  "name": "phonologic-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev",
    "lint": "bunx turbo run lint",
    "typecheck": "bunx turbo run typecheck",
    "format": "bunx prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "bunx turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "xlsx": "^0.18.5"
  },
  "packageManager": "bun@1.1.8",
  "dependencies": {
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0"
  }
}
